function setupPopupEventListeners(selectedText) {
    // Close button
    floatingPopup.querySelector('.pragma-close-btn').addEventListener('click', hideFloatingPopup);
    
    // Export button
    floatingPopup.querySelector('.pragma-export-btn').addEventListener('click', () => {
        if (currentAnalysis) {
            exportReport(currentAnalysis);
        }
    });

    // Tab switching
    const tabHeaders = floatingPopup.querySelectorAll('.tab-header');
    const tabContents = floatingPopup.querySelectorAll('.tab-content');
    
    tabHeaders.forEach(header => {
        header.addEventListener('click', function() {
            tabHeaders.forEach(h => h.classList.remove('active'));
            tabContents.forEach(c => c.classList.remove('active'));
            this.classList.add('active');
            const tabId = this.getAttribute('data-tab');
            floatingPopup.querySelector(`#${tabId}-content`).classList.add('active');
        });
    });

    // Analyze button
    const scanBtn = floatingPopup.querySelector('.popup-scan-btn');
    const clearBtn = floatingPopup.querySelector('.popup-clear-btn');

    scanBtn.addEventListener('click', () => {
        performDeepAnalysis(selectedText);
    });

    clearBtn.addEventListener('click', () => {
        clearAnalysis();
    });
}

function performDeepAnalysis(selectedText) {
    const statusEl = floatingPopup.querySelector('.status');
    statusEl.textContent = 'Analyzing...';
    
    setTimeout(() => {
        // Perform all analysis
        const results = analyzeText(selectedText);
        const entities = detectNamedEntities(selectedText);
        const weaselWords = detectWeaselWords(selectedText);
        const statistics = extractStatistics(selectedText);
        const sources = extractSources(selectedText);
        const citations = generateCitations(entities, sources);
        const readabilityScore = calculateReadability(selectedText);
        const readabilityInfo = getReadabilityLevel(readabilityScore);
        const ratings = calculateTextRatings(selectedText, results, entities, weaselWords, statistics, sources);
        
        // AI-SPECIFIC ANALYSIS
        const aiDetection = detectAIContent(selectedText);
        const aiCitations = generateAICitations(aiDetection.isLikelyAI);
        
        // Create temporary analysis object for verification steps
        const tempAnalysis = {
            statistics,
            entities,
            weaselWords
        };
        const verificationSteps = generateVerificationSteps(selectedText, tempAnalysis);
        
        // Store analysis
        currentAnalysis = {
            text: selectedText,
            results,
            entities,
            weaselWords,
            statistics,
            sources,
            citations,
            readabilityScore,
            readabilityInfo,
            ratings,
            aiDetection,
            aiCitations,
            verificationSteps
        };
        
        // Update scores
        const accuracyScore = Math.max(60, 100 - (results.needsReview * 10) - (results.needsCitation * 3) - (weaselWords.length * 2));
        
        document.getElementById('accuracy-score').textContent = accuracyScore + '%';
        document.getElementById('accuracy-score').style.color = accuracyScore >= 80 ? '#4CAF50' : accuracyScore >= 60 ? '#FFC107' : '#F44336';
        
        document.getElementById('readability-score').textContent = readabilityScore;
        document.getElementById('readability-score').style.color = readabilityInfo.color;
        
        document.getElementById('citation-count').textContent = results.needsCitation;
        document.getElementById('citation-count').style.color = results.needsCitation === 0 ? '#4CAF50' : '#F44336';
        
        // Build Summary Tab
        buildSummaryTab(currentAnalysis);
        
        // Build AI Detection Tab
        buildAIDetectionTab(currentAnalysis);
        
        // Build Ratings Tab
        buildRatingsTab(currentAnalysis);
        
        // Build Findings Tab
        buildFindingsTab(currentAnalysis);
        
        // Build Statistics Tab
        buildStatisticsTab(currentAnalysis);
        
        // Build Citations Tab
        buildCitationsTab(currentAnalysis);
        
        // Build Sources Tab
        buildSourcesTab(currentAnalysis);
        
        statusEl.textContent = 'Analysis complete!';
    }, 1200);
}

function buildSummaryTab(analysis) {
    const summaryContent = document.getElementById('summary-content');
    
    let html = '<div class="summary-container">';
    
    // Overview stats
    html += '<div class="summary-section">';
    html += '<h4 style="margin-bottom: 10px;">Overview</h4>';
    html += `<div class="summary-stat">Word Count: <strong>${analysis.text.split(/\s+/).length}</strong></div>`;
    html += `<div class="summary-stat">Character Count: <strong>${analysis.text.length}</strong></div>`;
    html += `<div class="summary-stat">Readability Level: <strong style="color: ${analysis.readabilityInfo.color}">${analysis.readabilityInfo.level} (${analysis.readabilityInfo.grade})</strong></div>`;
    html += '</div>';
    
    // Key metrics
    html += '<div class="summary-section">';
    html += '<h4 style="margin-bottom: 10px;">Key Metrics</h4>';
    html += `<div class="summary-stat">Citation Needs: <strong style="color: ${analysis.results.needsCitation === 0 ? '#4CAF50' : '#F44336'}">${analysis.results.needsCitation}</strong></div>`;
    html += `<div class="summary-stat">Accuracy Issues: <strong style="color: ${analysis.results.needsReview === 0 ? '#4CAF50' : '#F44336'}">${analysis.results.needsReview}</strong></div>`;
    html += `<div class="summary-stat">Weasel Words: <strong style="color: ${analysis.weaselWords.length === 0 ? '#4CAF50' : '#FF9800'}">${analysis.weaselWords.length}</strong></div>`;
    html += `<div class="summary-stat">Statistical Claims: <strong>${analysis.statistics.length}</strong></div>`;
    html += '</div>';
    
    // Detected entities
    if (analysis.entities.companies.length > 0 || analysis.entities.people.length > 0 || analysis.entities.organizations.length > 0) {
        html += '<div class="summary-section">';
        html += '<h4 style="margin-bottom: 10px;">Named Entities</h4>';
        html += `<div class="summary-stat">Companies: <strong>${analysis.entities.companies.length}</strong></div>`;
        html += `<div class="summary-stat">People: <strong>${analysis.entities.people.length}</strong></div>`;
        html += `<div class="summary-stat">Organizations: <strong>${analysis.entities.organizations.length}</strong></div>`;
        html += '</div>';
    }
    
    html += '</div>';
    
    summaryContent.innerHTML = html;
}

function buildAIDetectionTab(analysis) {
