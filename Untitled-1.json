// Highlight entities in text
function highlightEntitiesInText(text, entities) {
    let highlightedText = text;
    
    // Highlight companies in blue
    entities.companies.forEach(entity => {
        const regex = new RegExp(`(\\b${entity.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b)`, 'gi');
        highlightedText = highlightedText.replace(regex, '<span style="background: #e3f2fd; color: #1976d2; padding: 2px 4px; border-radius: 3px; font-weight: 600;">$1</span>');
    });

    // Highlight people in green
    entities.people.forEach(entity => {
        const regex = new RegExp(`(\\b${entity.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b)`, 'gi');
        highlightedText = highlightedText.replace(regex, '<span style="background: #e8f5e9; color: #388e3c; padding: 2px 4px; border-radius: 3px; font-weight: 600;">$1</span>');
    });

    // Highlight organizations in purple
    entities.organizations.forEach(entity => {
        const regex = new RegExp(`(\\b${entity.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b)`, 'gi');
        highlightedText = highlightedText.replace(regex, '<span style="background: #f3e5f5; color: #7b1fa2; padding: 2px 4px; border-radius: 3px; font-weight: 600;">$1</span>');
    });

    return highlightedText;
}

