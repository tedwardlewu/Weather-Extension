                    <div style="font-size: 10px; color: #333; font-family: monospace; background: white; padding: 8px; border-radius: 4px; margin-bottom: 6px; word-wrap: break-word;">${cit.citation}</div>
                    <div style="font-size: 10px; color: #666; margin-bottom: 4px;"><strong>In-text:</strong> ${cit.inText}</div>
