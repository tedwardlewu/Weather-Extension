    html += '<li style="margin-bottom: 4px;">Cite both the AI tool AND original sources</li>';
    html += '<li style="margin-bottom: 4px;">Paraphrase AI content in your own words</li>';
    html += '<li style="margin-bottom: 4px;">Check for outdated or incorrect information</li>';
    html += '<li>Be transparent about using AI assistance</li>';
    html += '</ul>';
    html += '</div>';
    
    // Subtle note about patterns detected - helpful, not accusatory
    if (ai.indicators && ai.indicators.length > 0) {
        html += '<div style="background: #f5f5f5; border-left: 4px solid #999; padding: 10px; border-radius: 6px;">';
        html += '<div style="font-weight: 600; font-size: 10px; color: #666; margin-bottom: 6px;">Note: Common AI Patterns Detected</div>';
        html += '<div style="font-size: 9px; color: #888; margin-bottom: 6px;">This text contains phrases commonly used by AI tools. Remember to cite your AI source properly.</div>';
        html += '<details style="margin-top: 6px;">';
        html += '<summary style="font-size: 9px; color: #667eea; cursor: pointer; font-weight: 600;">View detected patterns</summary>';
        html += '<div style="margin-top: 8px; padding-left: 8px;">';
        ai.indicators.slice(0, 5).forEach(indicator => {
            html += `<div style="font-size: 9px; color: #666; margin-bottom: 4px;">• "${indicator.phrase}"</div>`;
        });
        if (ai.indicators.length > 5) {
            html += `<div style="font-size: 9px; color: #999; margin-top: 4px;">...and ${ai.indicators.length - 5} more</div>`;
        }
        html += '</div></details>';
        html += '</div>';
    }
    
    html += '</div>';
    
    aiContent.innerHTML = html;
}

function buildRatingsTab(analysis) {
    const ratingsContent = document.getElementById('ratings-content');
    
    if (!analysis.ratings) {
        ratingsContent.innerHTML = '<p class="placeholder">No ratings available</p>';
        return;
    }
    
    let html = '<div class="ratings-container" style="padding: 5px;">';
    
    // Calculate reliability score based on multiple factors
    const citationCount = analysis.citations ? analysis.citations.length : 0;
    const accuracyIssues = analysis.results.findings.length;
    const weaselWordCount = analysis.weaselWords.length;
    const namedEntitiesCount = analysis.entities.companies.length + analysis.entities.people.length + analysis.entities.organizations.length;
    const wordCount = analysis.text.split(/\s+/).length;
    
    // Reliability calculation
    let reliabilityScore = 100;
    
    // Deduct for accuracy issues (critical)
    reliabilityScore -= (accuracyIssues * 15);
    
    // Deduct for lack of citations (moderate)
    const expectedCitations = Math.floor(wordCount / 150); // Expect 1 citation per ~150 words
    if (citationCount < expectedCitations) {
        reliabilityScore -= Math.min((expectedCitations - citationCount) * 8, 30);
    }
    
    // Deduct for weasel words (minor)
    reliabilityScore -= Math.min(weaselWordCount * 2, 20);
    
    // Deduct for unverified entities (moderate)
    if (namedEntitiesCount > 0 && citationCount === 0) {
        reliabilityScore -= Math.min(namedEntitiesCount * 3, 15);
    }
    
    // Ensure score is between 0-100
    reliabilityScore = Math.max(0, Math.min(100, reliabilityScore));
    
    // Get reliability status
    let reliabilityLabel = '';
    let reliabilityColor = '';
    let reliabilityEmoji = '';
    let reliabilityMessage = '';
    
    if (reliabilityScore >= 90) {
        reliabilityLabel = 'Highly Reliable';
        reliabilityColor = '#4CAF50';
        reliabilityEmoji = '🛡️';
        reliabilityMessage = 'Information appears well-supported and credible';
    } else if (reliabilityScore >= 75) {
        reliabilityLabel = 'Mostly Reliable';
        reliabilityColor = '#8BC34A';
        reliabilityEmoji = '✅';
        reliabilityMessage = 'Good foundation, minor improvements needed';
    } else if (reliabilityScore >= 60) {
        reliabilityLabel = 'Moderately Reliable';
        reliabilityColor = '#FFC107';
        reliabilityEmoji = '⚡';
        reliabilityMessage = 'Needs more citations and verification';
    } else if (reliabilityScore >= 40) {
        reliabilityLabel = 'Questionable';
        reliabilityColor = '#FF9800';
        reliabilityEmoji = '⚠️';
        reliabilityMessage = 'Significant accuracy concerns detected';
    } else {
        reliabilityLabel = 'Unreliable';
        reliabilityColor = '#F44336';
        reliabilityEmoji = '🚨';
        reliabilityMessage = 'Multiple critical issues require attention';
    }
    
    // Reliability Score Display
    html += `
        <div style="margin-bottom: 20px; padding: 20px; background: linear-gradient(135deg, ${reliabilityColor}22 0%, ${reliabilityColor}11 100%); border-radius: 12px; border: 2px solid ${reliabilityColor}; text-align: center;">
            <div style="font-size: 11px; color: #666; font-weight: 600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px;">Information Reliability</div>
            <div style="font-size: 56px; margin-bottom: 8px;">${reliabilityEmoji}</div>
            <div style="font-size: 42px; font-weight: 800; color: ${reliabilityColor}; margin-bottom: 6px;">${reliabilityScore}<span style="font-size: 20px; color: #999;">/100</span></div>
            <div style="font-size: 13px; padding: 6px 14px; border-radius: 20px; background: ${reliabilityColor}; color: white; font-weight: 600; display: inline-block; margin-bottom: 10px;">${reliabilityLabel}</div>
            <div style="font-size: 11px; color: #666; line-height: 1.4;">${reliabilityMessage}</div>
        </div>
    `;
    
    // Reliability breakdown
    html += '<div style="margin-bottom: 20px; padding: 15px; background: #f8f9fa; border-radius: 10px;">';
    html += '<div style="font-size: 11px; font-weight: 700; color: #666; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Reliability Factors</div>';
    html += '<div style="display: grid; gap: 8px;">';
    
    // Citations factor
    const citationStatus = citationCount >= expectedCitations ? '✓' : '✗';
    const citationColor = citationCount >= expectedCitations ? '#4CAF50' : '#FF9800';
    html += `
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px;">
            <span style="color: #666;">📚 Citations (${citationCount} found, ${expectedCitations} expected)</span>
            <span style="color: ${citationColor}; font-weight: 700; font-size: 14px;">${citationStatus}</span>
        </div>
    `;
    
    // Accuracy issues factor
    const accuracyStatus = accuracyIssues === 0 ? '✓' : '✗';
    const accuracyColor = accuracyIssues === 0 ? '#4CAF50' : '#F44336';
    html += `
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px;">
            <span style="color: #666;">🎯 Accuracy Issues (${accuracyIssues} found)</span>
            <span style="color: ${accuracyColor}; font-weight: 700; font-size: 14px;">${accuracyStatus}</span>
        </div>
    `;
    
    // Weasel words factor
    const weaselStatus = weaselWordCount < 3 ? '✓' : weaselWordCount < 6 ? '~' : '✗';
    const weaselColor = weaselWordCount < 3 ? '#4CAF50' : weaselWordCount < 6 ? '#FFC107' : '#FF9800';
    html += `
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px;">
            <span style="color: #666;">💬 Vague Language (${weaselWordCount} instances)</span>
            <span style="color: ${weaselColor}; font-weight: 700; font-size: 14px;">${weaselStatus}</span>
        </div>
    `;
    
    // Named entities factor
    const entityStatus = namedEntitiesCount === 0 || citationCount > 0 ? '✓' : '⚠';
    const entityColor = namedEntitiesCount === 0 || citationCount > 0 ? '#4CAF50' : '#FF9800';
    html += `
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px;">
            <span style="color: #666;">🏢 Unverified Entities (${namedEntitiesCount} found)</span>
            <span style="color: ${entityColor}; font-weight: 700; font-size: 14px;">${entityStatus}</span>
        </div>
    `;
    
    html += '</div></div>';
    
    // CONTENT ANALYSIS SECTION - What's actually in the text
    html += '<div style="margin-bottom: 20px;">';
    html += '<div style="background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%); padding: 3px; border-radius: 12px; margin-bottom: 15px;"><div style="background: white; padding: 15px; border-radius: 10px;">';
    html += '<div style="font-size: 12px; font-weight: 700; color: #1976D2; margin-bottom: 10px; display: flex; align-items: center;"><span style="margin-right: 6px;">🔍</span> CONTENT ANALYSIS</div>';
    html += '<p style="font-size: 10px; color: #666; margin-bottom: 15px; line-height: 1.5;">Analysis of claims, entities, and verifiable information in this AI-generated text.</p>';
    
    // Claims that need verification
    const totalClaims = analysis.results.findings.length + namedEntitiesCount;
    html += '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px;">';
    
    html += '<div style="background: #f5f5f5; padding: 12px; border-radius: 8px; text-align: center;">';
    html += `<div style="font-size: 24px; font-weight: 800; color: #1976D2;">${totalClaims}</div>`;
    html += '<div style="font-size: 10px; color: #666;">Claims Detected</div>';
    html += '</div>';
    
    html += '<div style="background: #f5f5f5; padding: 12px; border-radius: 8px; text-align: center;">';
    html += `<div style="font-size: 24px; font-weight: 800; color: ${citationCount >= expectedCitations ? '#4CAF50' : '#FF9800'};">${citationCount}</div>`;
    html += '<div style="font-size: 10px; color: #666;">Citations Provided</div>';
    html += '</div>';
    
    html += '</div>';
    
    // Named Entities Breakdown
    if (namedEntitiesCount > 0) {
        html += '<div style="margin-bottom: 12px;">';
        html += '<div style="font-size: 11px; font-weight: 600; color: #555; margin-bottom: 8px;">Named Entities Requiring Verification:</div>';
        
        if (analysis.entities.companies.length > 0) {
            html += `<div style="margin-bottom: 6px;">`;
            html += `<div style="font-size: 10px; color: #1976d2; margin-bottom: 4px; font-weight: 600;">Companies (${analysis.entities.companies.length}):</div>`;
            html += `<div style="display: flex; flex-wrap: wrap; gap: 4px;">`;
            analysis.entities.companies.slice(0, 5).forEach(c => {
                html += `<span style="background: #E3F2FD; color: #1565C0; padding: 3px 8px; border-radius: 4px; font-size: 10px;">${c}</span>`;
            });
            if (analysis.entities.companies.length > 5) {
                html += `<span style="background: #f5f5f5; color: #666; padding: 3px 8px; border-radius: 4px; font-size: 10px;">+${analysis.entities.companies.length - 5} more</span>`;
            }
            html += `</div></div>`;
        }
        
        if (analysis.entities.people.length > 0) {
            html += `<div style="margin-bottom: 6px;">`;
            html += `<div style="font-size: 10px; color: #388e3c; margin-bottom: 4px; font-weight: 600;">People (${analysis.entities.people.length}):</div>`;
            html += `<div style="display: flex; flex-wrap: wrap; gap: 4px;">`;
            analysis.entities.people.slice(0, 5).forEach(p => {
                html += `<span style="background: #E8F5E9; color: #2E7D32; padding: 3px 8px; border-radius: 4px; font-size: 10px;">${p}</span>`;
            });
            if (analysis.entities.people.length > 5) {
                html += `<span style="background: #f5f5f5; color: #666; padding: 3px 8px; border-radius: 4px; font-size: 10px;">+${analysis.entities.people.length - 5} more</span>`;
            }
            html += `</div></div>`;
        }
        
        if (analysis.entities.organizations.length > 0) {
            html += `<div>`;
            html += `<div style="font-size: 10px; color: #7b1fa2; margin-bottom: 4px; font-weight: 600;">Organizations (${analysis.entities.organizations.length}):</div>`;
            html += `<div style="display: flex; flex-wrap: wrap; gap: 4px;">`;
            analysis.entities.organizations.slice(0, 5).forEach(o => {
                html += `<span style="background: #F3E5F5; color: #6A1B9A; padding: 3px 8px; border-radius: 4px; font-size: 10px;">${o}</span>`;
            });
            if (analysis.entities.organizations.length > 5) {
                html += `<span style="background: #f5f5f5; color: #666; padding: 3px 8px; border-radius: 4px; font-size: 10px;">+${analysis.entities.organizations.length - 5} more</span>`;
            }
            html += `</div></div>`;
        }
        
        html += '</div>';
    }
    
    // Vague language summary
    if (weaselWordCount > 0) {
        html += '<div style="margin-bottom: 12px;">';
        html += '<div style="font-size: 11px; font-weight: 600; color: #555; margin-bottom: 6px;">Vague Language Found:</div>';
        html += '<div style="display: flex; flex-wrap: wrap; gap: 4px;">';
        analysis.weaselWords.slice(0, 6).forEach(w => {
            const color = w.severity === 'high' ? '#F44336' : w.severity === 'medium' ? '#FF9800' : '#FFC107';
            html += `<span style="background: #FFF3E0; color: ${color}; padding: 3px 8px; border-radius: 4px; font-size: 10px; border: 1px solid ${color};">"${w.phrase}"</span>`;
        });
        if (weaselWordCount > 6) {
            html += `<span style="background: #f5f5f5; color: #666; padding: 3px 8px; border-radius: 4px; font-size: 10px;">+${weaselWordCount - 6} more</span>`;
        }
        html += '</div>';
        html += '</div>';
    }
    
    // Research recommendation
    html += '<div style="background: #FFF3E0; padding: 10px; border-radius: 6px; border-left: 3px solid #FF9800; margin-top: 12px;">';
    html += '<div style="font-size: 10px; font-weight: 600; color: #E65100; margin-bottom: 4px;">💡 For Research & Academic Use:</div>';
    html += '<div style="font-size: 10px; color: #666; line-height: 1.4;">';
    if (citationCount === 0 && namedEntitiesCount > 0) {
        html += 'Verify all named entities independently. Cross-reference with authoritative sources before citing.';
    } else if (weaselWordCount > 5) {
        html += 'Replace vague language with specific, quantifiable statements backed by sources.';
    } else if (citationCount < expectedCitations) {
        html += `Add ${expectedCitations - citationCount} more citations to meet academic standards (~1 citation per 150 words).`;
    } else {
        html += 'Good foundation! Review each citation for credibility and relevance.';
    }
    html += '</div></div>';
    
    html += '</div></div></div>';
    
    // Simplified quality metrics - condensed version
    const scores = Object.values(analysis.ratings).map(r => r.score);
    const avgScore = (scores.reduce((a, b) => a + b, 0) / scores.length).toFixed(1);
    const avgColor = getRatingColor(Math.round(avgScore));
    
    html += '<div style="margin-top: 20px; padding: 15px; background: #f8f9fa; border-radius: 10px; border: 1px solid #e0e0e0;">';
    html += '<div style="font-size: 11px; font-weight: 700; color: #666; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px;">Quick Quality Overview</div>';
    html += '<div style="font-size: 10px; color: #888; margin-bottom: 12px;">Simplified view of key quality metrics</div>';
    html += '<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">';
    
    // Show only the most important metrics
    const importantMetrics = ['credibility', 'evidence', 'clarity'];
    Object.entries(analysis.ratings).forEach(([key, rating]) => {
        if (importantMetrics.includes(key)) {
            const color = getRatingColor(rating.score);
            html += `
                <div style="text-align: center; padding: 10px; background: white; border-radius: 6px; border: 1px solid #e0e0e0;">
                    <div style="font-size: 20px; font-weight: 700; color: ${color};">${rating.score}</div>
                    <div style="font-size: 9px; color: #666; text-transform: capitalize;">${rating.label}</div>
                </div>
            `;
        }
    });
    
    html += '</div></div>';
    html += '</div>';
    
    ratingsContent.innerHTML = html;
}

function buildFindingsTab(analysis) {
    const findingsContent = document.getElementById('findings-content');
    
    let html = '<div style="padding: 5px;">';
    
    // Summary stats at top
    const totalIssues = analysis.results.findings.length + analysis.weaselWords.length;
    const criticalIssues = analysis.results.findings.filter(f => f.type === 'error').length;
    const warnings = analysis.results.findings.filter(f => f.type === 'warning').length;
    
    if (totalIssues > 0) {
        html += `
            <div style="background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%); padding: 15px; border-radius: 10px; margin-bottom: 20px; border-left: 4px solid #FF9800;">
                <div style="font-size: 12px; font-weight: 700; color: #E65100; margin-bottom: 8px;">📋 Issues Overview</div>
                <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 100px;">
                        <div style="font-size: 24px; font-weight: 800; color: #F57C00;">${totalIssues}</div>
                        <div style="font-size: 10px; color: #666;">Total Issues</div>
                    </div>
                    ${criticalIssues > 0 ? `
                    <div style="flex: 1; min-width: 100px;">
                        <div style="font-size: 24px; font-weight: 800; color: #F44336;">${criticalIssues}</div>
                        <div style="font-size: 10px; color: #666;">Critical</div>
                    </div>` : ''}
                    ${warnings > 0 ? `
                    <div style="flex: 1; min-width: 100px;">
                        <div style="font-size: 24px; font-weight: 800; color: #FF9800;">${warnings}</div>
                        <div style="font-size: 10px; color: #666;">Citations Needed</div>
                    </div>` : ''}
                </div>
            </div>
        `;
    }
    
    // Accuracy issues - improved design
    if (analysis.results.findings.length > 0) {
        const errors = analysis.results.findings.filter(f => f.type === 'error');
        const citationWarnings = analysis.results.findings.filter(f => f.type === 'warning');
        
        if (errors.length > 0) {
            html += '<div style="margin-bottom: 20px;">';
            html += '<div style="font-size: 12px; font-weight: 700; color: #D32F2F; margin-bottom: 10px; display: flex; align-items: center;"><span style="margin-right: 6px;">🚨</span> Accuracy Issues</div>';
            html += errors.map((f, index) => {
                return `
                    <div style="padding: 12px; margin-bottom: 10px; background: #ffebee; border-left: 3px solid #F44336; border-radius: 6px;">
                        <div style="display: flex; align-items: start; margin-bottom: 6px;">
                            <span style="background: #F44336; color: white; font-size: 9px; padding: 2px 6px; border-radius: 3px; margin-right: 8px; font-weight: 700;">ISSUE ${index + 1}</span>
                            <span style="font-weight: 600; color: #C62828; font-size: 11px; flex: 1;">"${f.trigger}"</span>
                        </div>
                        <p style="margin: 0 0 8px 0; font-size: 11px; color: #555; line-height: 1.4;">${f.message}</p>
                        <div style="background: white; padding: 8px; border-radius: 4px; border-left: 2px solid #4CAF50;">
                            <div style="font-size: 9px; font-weight: 700; color: #2E7D32; margin-bottom: 4px;">💡 HOW TO FIX</div>
                            <p style="margin: 0; font-size: 10px; color: #555;">${f.suggestion}</p>
                        </div>
                    </div>
                `;
            }).join('');
            html += '</div>';
        }
        
        if (citationWarnings.length > 0) {
            html += '<div style="margin-bottom: 20px;">';
            html += '<div style="font-size: 12px; font-weight: 700; color: #F57C00; margin-bottom: 10px; display: flex; align-items: center;"><span style="margin-right: 6px;">📚</span> Citation Needed</div>';
            html += citationWarnings.map((f, index) => {
                return `
                    <div style="padding: 10px; margin-bottom: 8px; background: #fff8e1; border-left: 3px solid #FFC107; border-radius: 6px;">
                        <div style="font-weight: 600; color: #F57C00; font-size: 11px; margin-bottom: 4px;">"${f.trigger}"</div>
                        <p style="margin: 0; font-size: 10px; color: #666; line-height: 1.4;">${f.suggestion}</p>
                    </div>
                `;
            }).join('');
            html += '</div>';
        }
    }
    
    // Weasel words - improved
    if (analysis.weaselWords.length > 0) {
        const highSeverity = analysis.weaselWords.filter(w => w.severity === 'high');
        const mediumSeverity = analysis.weaselWords.filter(w => w.severity === 'medium');
        const lowSeverity = analysis.weaselWords.filter(w => w.severity === 'low');
        
        html += '<div style="margin-bottom: 20px;">';
        html += '<div style="font-size: 12px; font-weight: 700; color: #7B1FA2; margin-bottom: 10px; display: flex; align-items: center;"><span style="margin-right: 6px;">🎯</span> Vague Language Detected</div>';
        html += '<p style="font-size: 10px; color: #666; margin-bottom: 12px; line-height: 1.4;">These phrases weaken your argument. Replace with specific, verifiable statements.</p>';
        
        if (highSeverity.length > 0) {
            html += '<div style="margin-bottom: 12px;">';
            html += '<div style="font-size: 10px; font-weight: 600; color: #F44336; margin-bottom: 6px;">High Priority:</div>';
            html += '<div style="display: flex; flex-wrap: wrap; gap: 6px;">';
            highSeverity.forEach(w => {
                html += `<span style="background: #ffebee; color: #C62828; padding: 4px 8px; border-radius: 4px; font-size: 10px; border: 1px solid #F44336;">"${w.phrase}"</span>`;
            });
            html += '</div></div>';
        }
        
        if (mediumSeverity.length > 0) {
            html += '<div style="margin-bottom: 12px;">';
            html += '<div style="font-size: 10px; font-weight: 600; color: #FF9800; margin-bottom: 6px;">Medium Priority:</div>';
            html += '<div style="display: flex; flex-wrap: wrap; gap: 6px;">';
            mediumSeverity.forEach(w => {
                html += `<span style="background: #fff3e0; color: #E65100; padding: 4px 8px; border-radius: 4px; font-size: 10px; border: 1px solid #FF9800;">"${w.phrase}"</span>`;
            });
            html += '</div></div>';
        }
        
        if (lowSeverity.length > 0) {
            html += '<div>';
            html += '<div style="font-size: 10px; font-weight: 600; color: #FFC107; margin-bottom: 6px;">Low Priority:</div>';
            html += '<div style="display: flex; flex-wrap: wrap; gap: 6px;">';
            lowSeverity.forEach(w => {
                html += `<span style="background: #fffbea; color: #F57F17; padding: 4px 8px; border-radius: 4px; font-size: 10px; border: 1px solid #FFC107;">"${w.phrase}"</span>`;
            });
            html += '</div></div>';
        }
        
        html += '</div>';
    }
    
    // Named entities - improved
    const hasEntities = analysis.entities.companies.length > 0 || 
                       analysis.entities.people.length > 0 || 
                       analysis.entities.organizations.length > 0;
    
    if (hasEntities) {
        const totalEntities = analysis.entities.companies.length + analysis.entities.people.length + analysis.entities.organizations.length;
        
        html += '<div style="background: #e8eaf6; padding: 12px; border-radius: 8px; border-left: 3px solid #5C6BC0;">';
        html += '<div style="font-size: 12px; font-weight: 700; color: #3949AB; margin-bottom: 8px; display: flex; align-items: center;"><span style="margin-right: 6px;">🏢</span> Named Entities Found</div>';
        html += `<p style="font-size: 10px; color: #666; margin-bottom: 12px;">${totalEntities} entities detected. Verify accuracy and consider adding citations.</p>`;
        
        if (analysis.entities.companies.length > 0) {
            html += `<div style="margin-bottom: 10px;">`;
            html += `<div style="font-size: 10px; font-weight: 600; color: #1976d2; margin-bottom: 6px;">Companies (${analysis.entities.companies.length}):</div>`;
            html += `<div style="display: flex; flex-wrap: wrap; gap: 4px;">`;
            analysis.entities.companies.forEach(c => {
                html += `<span style="background: white; color: #1565C0; padding: 3px 8px; border-radius: 4px; font-size: 10px; border: 1px solid #42A5F5;">${c}</span>`;
            });
            html += `</div></div>`;
        }
        
        if (analysis.entities.people.length > 0) {
            html += `<div style="margin-bottom: 10px;">`;
            html += `<div style="font-size: 10px; font-weight: 600; color: #388e3c; margin-bottom: 6px;">People (${analysis.entities.people.length}):</div>`;
            html += `<div style="display: flex; flex-wrap: wrap; gap: 4px;">`;
            analysis.entities.people.forEach(p => {
                html += `<span style="background: white; color: #2E7D32; padding: 3px 8px; border-radius: 4px; font-size: 10px; border: 1px solid #66BB6A;">${p}</span>`;
            });
            html += `</div></div>`;
        }
        
        if (analysis.entities.organizations.length > 0) {
            html += `<div>`;
            html += `<div style="font-size: 10px; font-weight: 600; color: #7b1fa2; margin-bottom: 6px;">Organizations (${analysis.entities.organizations.length}):</div>`;
            html += `<div style="display: flex; flex-wrap: wrap; gap: 4px;">`;
            analysis.entities.organizations.forEach(o => {
                html += `<span style="background: white; color: #6A1B9A; padding: 3px 8px; border-radius: 4px; font-size: 10px; border: 1px solid #AB47BC;">${o}</span>`;
            });
            html += `</div></div>`;
        }
        
        html += '</div>';
    }
    
    // All clear message
    if (totalIssues === 0 && !hasEntities) {
        html += `
            <div style="text-align: center; padding: 40px 20px;">
                <div style="font-size: 48px; margin-bottom: 12px;">✅</div>
                <div style="font-size: 14px; font-weight: 700; color: #4CAF50; margin-bottom: 6px;">Looking Great!</div>
                <div style="font-size: 11px; color: #666;">No major issues detected in your text.</div>
            </div>
        `;
    }
    
    html += '</div>';
    
    findingsContent.innerHTML = html;
}

function buildStatisticsTab(analysis) {
    const statsContent = document.getElementById('statistics-content');
    
    if (analysis.statistics.length === 0) {
        statsContent.innerHTML = '<p class="placeholder">No statistical claims detected</p>';
        return;
    }
    
    let html = '<div class="statistics-section">';
    html += `<h4 style="margin-bottom: 10px;">${analysis.statistics.length} Statistical Claims Found</h4>`;
    html += '<p style="font-size: 12px; color: #666; margin-bottom: 12px;">All numerical claims should be verified and cited</p>';
    
    analysis.statistics.forEach(stat => {
        html += `
            <div class="stat-item" style="padding: 10px; margin-bottom: 10px; background: #f5f5f5; border-radius: 6px; border-left: 3px solid #667eea;">
                <div style="display: flex; align-items: center; margin-bottom: 6px;">
                    <span style="font-size: 18px; margin-right: 8px;">${stat.icon}</span>
                    <span style="font-weight: 700; color: #667eea; font-size: 16px;">${stat.value}</span>
                    <span style="margin-left: auto; font-size: 10px; background: #667eea; color: white; padding: 2px 6px; border-radius: 3px;">${stat.type}</span>
                </div>
                <p style="font-size: 12px; color: #555; margin: 0;">${stat.context}</p>
                <button class="copy-stat-btn" data-value="${stat.value}" style="margin-top: 6px; font-size: 10px; padding: 4px 8px; background: white; border: 1px solid #ddd; border-radius: 3px; cursor: pointer;">Copy</button>
            </div>
        `;
    });
    
    html += '</div>';
    
    statsContent.innerHTML = html;
    
    // Add copy listeners
    statsContent.querySelectorAll('.copy-stat-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const value = e.target.getAttribute('data-value');
            navigator.clipboard.writeText(value);
            e.target.textContent = 'Copied!';
            setTimeout(() => {
                e.target.textContent = 'Copy';
            }, 2000);
        });
    });
}

function buildCitationsTab(analysis) {
    const citationsContent = document.getElementById('citations-content');
    
    if (analysis.citations.length === 0) {
        citationsContent.innerHTML = '<p class="placeholder">No citation suggestions available</p>';
        return;
    }
    
    let html = '<div class="citations-section">';
    html += `<h4 style="margin-bottom: 10px;">${analysis.citations.length} Citation Templates (APA Style)</h4>`;
    html += '<p style="font-size: 12px; color: #666; margin-bottom: 12px;">Fill in the bracketed details with actual information</p>';
    
    analysis.citations.forEach(citation => {
        const typeColor = citation.type === 'person' ? '#388e3c' : citation.type === 'organization' ? '#7b1fa2' : '#1976d2';
        html += `
            <div class="citation-item" style="padding: 10px; margin-bottom: 10px; background: #fafafa; border-radius: 6px; border-left: 3px solid ${typeColor};">
                <div style="display: flex; align-items: center; margin-bottom: 6px;">
                    <span style="font-weight: 600; color: ${typeColor}; font-size: 12px;">${citation.entity}</span>
                    <span style="margin-left: auto; font-size: 10px; background: ${typeColor}; color: white; padding: 2px 6px; border-radius: 3px;">${citation.type}</span>
                </div>
                <p style="font-size: 11px; color: #333; margin: 0; font-family: monospace; background: white; padding: 8px; border-radius: 4px;">${citation.citation}</p>
                <button class="copy-citation-btn" data-citation="${citation.citation.replace(/"/g, '&quot;')}" style="margin-top: 6px; font-size: 10px; padding: 4px 8px; background: ${typeColor}; color: white; border: none; border-radius: 3px; cursor: pointer;">Copy Citation</button>
            </div>
        `;
    });
    
    html += '</div>';
    
    citationsContent.innerHTML = html;
    
    // Add copy listeners
    citationsContent.querySelectorAll('.copy-citation-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const citation = e.target.getAttribute('data-citation');
            navigator.clipboard.writeText(citation);
            e.target.textContent = 'Copied!';
            setTimeout(() => {
                e.target.textContent = 'Copy Citation';
            }, 2000);
        });
    });
}

function buildSourcesTab(analysis) {
    const sourcesContent = document.getElementById('sources-content');
    
    if (analysis.sources.length === 0) {
        sourcesContent.innerHTML = '<p class="placeholder">No sources or URLs detected</p>';
        return;
    }
    
    let html = '<div class="sources-section">';
    html += `<h4 style="margin-bottom: 10px;">${analysis.sources.length} Sources Detected</h4>`;
    
    analysis.sources.forEach(source => {
        const typeColor = source.type === 'url' ? '#1976d2' : '#7b1fa2';
        html += `
            <div class="source-item" style="padding: 10px; margin-bottom: 10px; background: #f0f4ff; border-radius: 6px; border-left: 3px solid ${typeColor};">
                <div style="display: flex; align-items: center; margin-bottom: 6px;">
                    <span style="font-size: 16px; margin-right: 8px;">${source.icon}</span>
                    <span style="font-size: 10px; background: ${typeColor}; color: white; padding: 2px 6px; border-radius: 3px;">${source.type}</span>
                </div>
                <p style="font-size: 12px; color: #333; margin: 0; word-break: break-all;">${source.value}</p>
                ${source.type === 'url' ? `<a href="${source.value}" target="_blank" style="font-size: 10px; color: #1976d2; margin-top: 6px; display: inline-block;">Open Link</a>` : ''}
            </div>
        `;
    });
    
    html += '</div>';
    
    sourcesContent.innerHTML = html;
}

function clearAnalysis() {
    currentAnalysis = null;
    
    document.getElementById('accuracy-score').textContent = '--';
    document.getElementById('accuracy-score').style.color = '#666';
    document.getElementById('readability-score').textContent = '--';
    document.getElementById('readability-score').style.color = '#666';
    document.getElementById('citation-count').textContent = '--';
    document.getElementById('citation-count').style.color = '#666';
    
    document.getElementById('summary-content').innerHTML = '<p class="placeholder">Click "Deep Analyze" to scan text</p>';
    document.getElementById('ai-detection-content').innerHTML = '<p class="placeholder">No AI detection yet</p>';
    document.getElementById('ratings-content').innerHTML = '<p class="placeholder">No ratings yet</p>';
    document.getElementById('findings-content').innerHTML = '<p class="placeholder">No analysis yet</p>';
    document.getElementById('statistics-content').innerHTML = '<p class="placeholder">No statistics detected yet</p>';
    document.getElementById('citations-content').innerHTML = '<p class="placeholder">No citations generated yet</p>';
    document.getElementById('sources-content').innerHTML = '<p class="placeholder">No sources detected yet</p>';
    
    floatingPopup.querySelector('.status').textContent = 'Ready to scan';
}

function exportReport(analysis) {
    const report = `
PRAGMA AI CITATION SCANNER - ANALYSIS REPORT
============================================

TEXT ANALYZED:
${analysis.text}

SCORES:
-------
Accuracy Score: ${Math.max(60, 100 - (analysis.results.needsReview * 10) - (analysis.results.needsCitation * 3) - (analysis.weaselWords.length * 2))}%
Readability Score: ${analysis.readabilityScore} (${analysis.readabilityInfo.level} - ${analysis.readabilityInfo.grade})

QUALITY RATINGS (0-10 Scale):
------------------------------
${Object.keys(analysis.ratings || {}).map(key => {
    const r = analysis.ratings[key];
    return `${r.label}: ${r.score}/10 (${getRatingLabel(r.score)}) - ${r.description}`;
}).join('\n')}

Overall Rating: ${Object.values(analysis.ratings || {}).length > 0 ? 
    (Object.values(analysis.ratings).reduce((sum, r) => sum + r.score, 0) / Object.values(analysis.ratings).length).toFixed(1) : 'N/A'}/10

STATISTICS:
-----------
Word Count: ${analysis.text.split(/\s+/).length}
Character Count: ${analysis.text.length}
Citation Needs: ${analysis.results.needsCitation}
Accuracy Issues: ${analysis.results.needsReview}
Weasel Words: ${analysis.weaselWords.length}
Statistical Claims: ${analysis.statistics.length}

FINDINGS:
---------
${analysis.results.findings.map(f => `- ${f.message}\n  Suggestion: ${f.suggestion}`).join('\n')}

WEASEL WORDS:
-------------
${analysis.weaselWords.map(w => `- "${w.phrase}" (${w.severity} severity)`).join('\n')}

NAMED ENTITIES:
---------------
Companies: ${analysis.entities.companies.join(', ')}
People: ${analysis.entities.people.join(', ')}
Organizations: ${analysis.entities.organizations.join(', ')}

STATISTICAL CLAIMS:
-------------------
${analysis.statistics.map(s => `- ${s.value} (${s.type}): ${s.context}`).join('\n')}

SOURCES:
--------
${analysis.sources.map(s => `- ${s.value} (${s.type})`).join('\n')}

CITATIONS (APA Style):
---------------------
${analysis.citations.map(c => c.citation).join('\n')}

Report generated by Pragma AI Citation Scanner
    `.trim();
    
    // Copy to clipboard
    navigator.clipboard.writeText(report);
    
    // Show notification
    const exportBtn = floatingPopup.querySelector('.pragma-export-btn');
    const originalText = exportBtn.innerHTML;
    exportBtn.innerHTML = 'Exported!';
    exportBtn.style.background = '#4CAF50';
    
    setTimeout(() => {
        exportBtn.innerHTML = originalText;
        exportBtn.style.background = '';
    }, 2000);
    
    // Also download as file
    const blob = new Blob([report], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pragma-report-${Date.now()}.txt`;
    a.click();
    URL.revokeObjectURL(url);
}

// Listen for messages from background script
chrome.runtime.onMessage.addListener((request, sender, sendResponse) => {
    if (request.action === 'scanSelection' && request.text) {
        const selection = window.getSelection();
        if (selection.rangeCount > 0) {
            const range = selection.getRangeAt(0);
            const rect = range.getBoundingClientRect();
            showFloatingPopup(request.text, rect);
        }
        sendResponse({ success: true });
    }
    return true;
});

