        html += '<p style="font-size: 10px; color: #666; margin-bottom: 12px;">Essential steps to verify AI-generated content before using it:</p>';
        
        analysis.verificationSteps.forEach(step => {
            const criticalBadge = step.critical ? '<span style="background: #F44336; color: white; font-size: 8px; padding: 2px 6px; border-radius: 3px; margin-left: 6px; font-weight: 600;">CRITICAL</span>' : '';
            
            html += `
                <div style="background: ${step.critical ? '#ffebee' : '#f8f9fa'}; padding: 10px; margin-bottom: 8px; border-radius: 6px; border-left: 3px solid ${step.critical ? '#F44336' : '#4CAF50'};">
                    <div style="font-size: 11px; font-weight: 600; color: #333; margin-bottom: 4px;">Step ${step.step}: ${step.action}${criticalBadge}</div>
                    <div style="font-size: 10px; color: #666;">${step.description}</div>
                </div>
            `;
        });
        
        html += '</div>';
