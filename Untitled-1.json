// Content script for Pragma AI Citation Scanner
let floatingButton = null;
let floatingPopup = null;
let keywords = [];
let highlightedElements = [];
let currentAnalysis = null;
let isPopupOpen = false; // Track if popup is open

console.log('Pragma AI: Content script loaded!');

// Load keywords.json dynamically
fetch(chrome.runtime.getURL('keywords.json'))
  .then(response => response.json())
  .then(data => {
    keywords = data;
    console.log('Pragma AI: Keywords loaded:', keywords.length);
  })
  .catch(err => console.error('❌ Pragma AI: Failed to load keywords.json:', err));

// Show floating button when user highlights text
document.addEventListener('mouseup', handleTextSelection);

// Hide button/popup if click outside
document.addEventListener('mousedown', (e) => {
    if (floatingButton && !floatingButton.contains(e.target)) {
        hideFloatingButton();
    }
    if (floatingPopup && !floatingPopup.contains(e.target)) {
        hideFloatingPopup();
    }
});

function handleTextSelection() {
    setTimeout(() => {
        const selection = window.getSelection();
        const text = selection.toString().trim();

        console.log('Text selected:', text.length, 'characters');

        // Don't show button if popup is already open
        if (text.length > 10 && !isPopupOpen) {
            console.log('Showing button for:', text.substring(0, 50) + '...');
            showFloatingButton(selection);
        } else {
            hideFloatingButton();
        }
    }, 10);
}

function showFloatingButton(selection) {
    hideFloatingButton();

    const range = selection.getRangeAt(0);
    const rect = range.getBoundingClientRect();

    floatingButton = document.createElement('div');
    floatingButton.className = 'pragma-floating-button';
    
    const button = document.createElement('button');
    button.className = 'pragma-scan-btn';
    button.innerHTML = '<span>Scan with Pragma AI</span>';

    const buttonWidth = 180;
    let leftPos = rect.left + window.scrollX + (rect.width / 2) - (buttonWidth / 2);
    let topPos = rect.top + window.scrollY - 45;

    // Keep button on screen
    if (leftPos < 10) leftPos = 10;
    if (leftPos + buttonWidth > window.innerWidth) {
        leftPos = window.innerWidth - buttonWidth - 10;
    }
    if (topPos < 10) {
        topPos = rect.bottom + window.scrollY + 10;
    }

    floatingButton.style.position = 'absolute';
    floatingButton.style.left = leftPos + 'px';
    floatingButton.style.top = topPos + 'px';
    floatingButton.style.zIndex = '999999';

    button.addEventListener('click', (e) => {
        e.stopPropagation();
        const selectedText = selection.toString();
        hideFloatingButton();
        showFloatingPopup(selectedText, rect);
    });

    floatingButton.appendChild(button);
    document.body.appendChild(floatingButton);
}

function hideFloatingButton() {
    if (floatingButton) {
        floatingButton.remove();
        floatingButton = null;
    }
}

function hideFloatingPopup() {
    if (floatingPopup) {
        floatingPopup.remove();
        floatingPopup = null;
        isPopupOpen = false; // Clear popup open flag
        
        // Don't automatically show the button again
        // User needs to select text again to see the button
    }
}

// ============================================
// ANALYSIS FUNCTIONS
// ============================================

// Calculate comprehensive ratings (0-10 scale) for text quality
function calculateTextRatings(text, results, entities, weaselWords, statistics, sources) {
    const ratings = {};
    
    // 1. CLARITY - How clear and understandable the text is
    const avgSentenceLength = text.split(/[.!?]+/).filter(s => s.trim()).length > 0 
        ? text.split(/\s+/).length / text.split(/[.!?]+/).filter(s => s.trim()).length 
        : 0;
    const complexWords = text.split(/\s+/).filter(w => countSyllables(w) > 3).length;
    const clarityScore = Math.max(0, Math.min(10, 
        10 - (avgSentenceLength > 20 ? 2 : 0) - (complexWords / text.split(/\s+/).length * 100 > 20 ? 3 : 0)
    ));
    ratings.clarity = {
        score: Math.round(clarityScore),
        label: 'Clarity',
        description: 'How clear and easy to understand'
    };
    
    // 2. CREDIBILITY - How trustworthy and believable
    const hasEvidence = sources.length > 0 ? 2 : 0;
    const hasCitations = results.needsCitation === 0 ? 3 : Math.max(0, 3 - results.needsCitation);
    const hasEntities = (entities.companies.length + entities.people.length + entities.organizations.length) > 0 ? 2 : 0;
    const lowWeasel = Math.max(0, 3 - weaselWords.length);
    ratings.credibility = {
        score: Math.round(hasEvidence + hasCitations + hasEntities + lowWeasel),
        label: 'Credibility',
        description: 'How trustworthy and well-sourced'
    };
    
    // 3. FORMALITY - How formal vs casual
    const casualWords = ['gonna', 'wanna', 'yeah', 'ok', 'hey', 'cool', 'awesome', 'stuff', 'things', 'kinda', 'sorta'];
    const casualCount = casualWords.filter(w => text.toLowerCase().includes(w)).length;
    const contractions = (text.match(/\b\w+'\w+\b/g) || []).length;
    const formalityScore = Math.max(0, Math.min(10, 10 - casualCount - (contractions > 5 ? 2 : 0)));
    ratings.formality = {
        score: Math.round(formalityScore),
        label: 'Formality',
        description: 'Professional vs casual tone'
    };
    
    // 4. OBJECTIVITY - How neutral vs biased
    const emotionalWords = ['amazing', 'terrible', 'awful', 'fantastic', 'horrible', 'wonderful', 'disgusting', 'beautiful', 'ugly', 'perfect', 'worst', 'best'];
    const emotionalCount = emotionalWords.filter(w => text.toLowerCase().includes(w)).length;
    const absoluteStatements = (text.match(/\b(always|never|everyone|nobody|all|none)\b/gi) || []).length;
    const objectivityScore = Math.max(0, Math.min(10, 10 - emotionalCount - absoluteStatements));
    ratings.objectivity = {
        score: Math.round(objectivityScore),
        label: 'Objectivity',
        description: 'Neutral vs biased language'
    };
    
    // 5. CONFIDENCE - How certain vs uncertain
    const uncertainWords = ['maybe', 'perhaps', 'possibly', 'might', 'could', 'may', 'probably', 'seems', 'appears'];
    const uncertainCount = uncertainWords.filter(w => text.toLowerCase().includes(w)).length;
    const hedgingPhrases = weaselWords.filter(w => w.severity === 'low' || w.severity === 'medium').length;
    const confidenceScore = Math.max(0, Math.min(10, 10 - uncertainCount - hedgingPhrases));
    ratings.confidence = {
        score: Math.round(confidenceScore),
        label: 'Confidence',
        description: 'Certainty of statements'
    };
    
    // 6. COMPLETENESS - How thorough and comprehensive
    const wordCount = text.split(/\s+/).length;
    const hasStats = statistics.length > 0 ? 2 : 0;
    const hasMultipleSources = sources.length > 1 ? 2 : 0;
    const hasEntitiesBonus = (entities.companies.length + entities.people.length + entities.organizations.length) > 3 ? 2 : 0;
    const lengthScore = wordCount > 100 ? 4 : wordCount > 50 ? 2 : 1;
    ratings.completeness = {
        score: Math.min(10, hasStats + hasMultipleSources + hasEntitiesBonus + lengthScore),
        label: 'Completeness',
        description: 'Thoroughness and detail'
    };
    
    // 7. CONCISENESS - How concise vs verbose
    const wordiness = ['very', 'really', 'quite', 'just', 'actually', 'basically', 'literally', 'seriously'];
    const wordyCount = wordiness.filter(w => text.toLowerCase().includes(w)).length;
    const avgWordLength = text.split(/\s+/).reduce((sum, w) => sum + w.length, 0) / text.split(/\s+/).length;
    const concisenessScore = Math.max(0, Math.min(10, 10 - wordyCount - (avgWordLength > 7 ? 2 : 0)));
    ratings.conciseness = {
        score: Math.round(concisenessScore),
        label: 'Conciseness',
        description: 'Brief and to the point'
    };
    
    // 8. PROFESSIONALISM - Overall professional quality
    const grammarIssues = (text.match(/\s{2,}/g) || []).length; // Multiple spaces
    const allCaps = (text.match(/\b[A-Z]{4,}\b/g) || []).filter(w => !entities.companies.includes(w) && !entities.organizations.includes(w)).length;
    const exclamations = (text.match(/!/g) || []).length;
    const professionalismScore = Math.max(0, Math.min(10, 10 - grammarIssues - allCaps - (exclamations > 3 ? 2 : 0)));
    ratings.professionalism = {
        score: Math.round(professionalismScore),
        label: 'Professionalism',
        description: 'Overall professional quality'
    };
    
    // 9. EVIDENCE QUALITY - How well-supported with evidence
    const statsRatio = statistics.length / (text.split(/\s+/).length / 100); // Stats per 100 words
    const sourceRatio = sources.length / (text.split(/\s+/).length / 100);
    const evidenceScore = Math.min(10, Math.round(
        (statsRatio > 0 ? 3 : 0) +
        (sourceRatio > 0 ? 3 : 0) +
        (statistics.length > 3 ? 2 : statistics.length) +
        (sources.length > 1 ? 2 : sources.length)
    ));
    ratings.evidenceQuality = {
        score: evidenceScore,
        label: 'Evidence Quality',
        description: 'Strength of supporting data'
    };
    
    // 10. WRITING QUALITY - Grammar, style, flow
    const readabilityScore = calculateReadability(text);
    const sentenceVariety = new Set(text.split(/[.!?]+/).map(s => s.trim().split(/\s+/).length)).size;
    const writingScore = Math.round(
        (readabilityScore >= 60 ? 5 : readabilityScore >= 50 ? 3 : 2) +
        (sentenceVariety > 3 ? 3 : sentenceVariety > 1 ? 2 : 1) +
        (results.needsReview === 0 ? 2 : 0)
    );
    ratings.writingQuality = {
        score: Math.min(10, writingScore),
        label: 'Writing Quality',
        description: 'Grammar, style, and flow'
    };
    
    return ratings;
}

// Get color for rating score
function getRatingColor(score) {
    if (score >= 9) return '#4CAF50'; // Excellent - Green
    if (score >= 7) return '#8BC34A'; // Good - Light Green
    if (score >= 5) return '#FFC107'; // Average - Yellow
    if (score >= 3) return '#FF9800'; // Poor - Orange
    return '#F44336'; // Very Poor - Red
}

// Get rating label
function getRatingLabel(score) {
    if (score >= 9) return 'Excellent';
    if (score >= 7) return 'Good';
    if (score >= 5) return 'Average';
    if (score >= 3) return 'Poor';
    return 'Very Poor';
}

// Calculate readability score (Flesch Reading Ease)
function calculateReadability(text) {
    const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0);
    const words = text.split(/\s+/).filter(w => w.length > 0);
    const syllables = words.reduce((count, word) => count + countSyllables(word), 0);
    
    if (sentences.length === 0 || words.length === 0) return 0;
    
    const avgWordsPerSentence = words.length / sentences.length;
    const avgSyllablesPerWord = syllables / words.length;
    
    const score = 206.835 - (1.015 * avgWordsPerSentence) - (84.6 * avgSyllablesPerWord);
    
    return Math.max(0, Math.min(100, Math.round(score)));
}

function countSyllables(word) {
    word = word.toLowerCase().replace(/[^a-z]/g, '');
    if (word.length <= 3) return 1;
    
    const vowels = 'aeiouy';
    let count = 0;
    let prevWasVowel = false;
    
    for (let i = 0; i < word.length; i++) {
        const isVowel = vowels.includes(word[i]);
        if (isVowel && !prevWasVowel) count++;
        prevWasVowel = isVowel;
    }
    
    if (word.endsWith('e')) count--;
    return Math.max(1, count);
}

function getReadabilityLevel(score) {
    if (score >= 90) return { level: 'Very Easy', color: '#4CAF50', grade: '5th grade' };
    if (score >= 80) return { level: 'Easy', color: '#8BC34A', grade: '6th grade' };
    if (score >= 70) return { level: 'Fairly Easy', color: '#CDDC39', grade: '7th grade' };
    if (score >= 60) return { level: 'Standard', color: '#FFC107', grade: '8-9th grade' };
    if (score >= 50) return { level: 'Fairly Difficult', color: '#FF9800', grade: '10-12th grade' };
    if (score >= 30) return { level: 'Difficult', color: '#FF5722', grade: 'College' };
    return { level: 'Very Difficult', color: '#F44336', grade: 'College Graduate' };
}

// ============================================
// AI CONTENT DETECTION & CITATION FUNCTIONS
// ============================================

// Detect AI-generated content patterns and score likelihood
function detectAIContent(text) {
    let aiScore = 0;
    const indicators = [];
    
    // AI-SPECIFIC PATTERNS
    
    // 1. Overly formal/structured openings
    const formalOpenings = [
        'in today\'s digital age', 'in recent years', 'it is important to note',
        'it is worth mentioning', 'as we delve into', 'when it comes to',
        'in the realm of', 'in the context of', 'let\'s explore', 'let\'s dive into'
    ];
    formalOpenings.forEach(phrase => {
        if (text.toLowerCase().includes(phrase)) {
            aiScore += 8;
            indicators.push({ phrase, reason: 'Common AI opening phrase' });
        }
    });
    
    // 2. Hedging language (AI loves to be cautious)
    const hedgingPhrases = [
        'it\'s important to note', 'it should be noted', 'one might argue',
        'it could be argued', 'some may say', 'in some cases', 'to some extent'
    ];
    hedgingPhrases.forEach(phrase => {
        if (text.toLowerCase().includes(phrase)) {
            aiScore += 5;
            indicators.push({ phrase, reason: 'AI hedging pattern' });
        }
    });
    
    // 3. Numbered lists/structured format
    if (text.match(/\b\d+\.\s+[A-Z]/g)) {
        const matches = text.match(/\b\d+\.\s+[A-Z]/g).length;
        if (matches >= 3) {
            aiScore += 10;
            indicators.push({ phrase: 'Numbered list format', reason: 'AI loves structured lists' });
        }
    }
    
    // 4. Lack of personal pronouns (I, my, we)
    const personalPronouns = (text.match(/\b(I|my|we|our|us)\b/gi) || []).length;
    const wordCount = text.split(/\s+/).length;
    if (personalPronouns / wordCount < 0.01 && wordCount > 50) {
        aiScore += 7;
        indicators.push({ phrase: 'No personal pronouns', reason: 'AI avoids first person' });
    }
    
    // 5. Perfect grammar (no typos, perfect punctuation)
    const typoIndicators = text.match(/\b\w+ing\s+and\b|\bteh\b|\brecieve\b|\boccur\b/gi);
    if (!typoIndicators && wordCount > 100) {
        aiScore += 5;
        indicators.push({ phrase: 'Perfect grammar', reason: 'Unusually error-free' });
    }
    
    // 6. Balanced structure (equal paragraph lengths)
    const paragraphs = text.split(/\n\n+/).filter(p => p.trim().length > 0);
    if (paragraphs.length >= 3) {
        const lengths = paragraphs.map(p => p.split(/\s+/).length);
        const avgLength = lengths.reduce((a, b) => a + b, 0) / lengths.length;
        const variance = lengths.every(l => Math.abs(l - avgLength) < avgLength * 0.3);
        if (variance) {
            aiScore += 6;
            indicators.push({ phrase: 'Uniform paragraph length', reason: 'Too balanced for human writing' });
        }
    }
    
    // 7. Generic transitions
    const genericTransitions = [
        'furthermore', 'moreover', 'in addition', 'however', 'nevertheless',
        'consequently', 'therefore', 'thus', 'hence'
    ];
    let transitionCount = 0;
    genericTransitions.forEach(transition => {
        if (text.toLowerCase().includes(transition)) transitionCount++;
    });
    if (transitionCount >= 3) {
        aiScore += 7;
        indicators.push({ phrase: 'Multiple formal transitions', reason: 'AI overuses transitions' });
    }
    
    // 8. Lack of contractions (AI writes formally)
    const contractions = (text.match(/\b\w+'\w+\b/g) || []).length;
    if (contractions === 0 && wordCount > 50) {
        aiScore += 6;
        indicators.push({ phrase: 'No contractions', reason: 'Overly formal style' });
    }
    
    // 9. Generic concluding phrases
    const conclusions = [
        'in conclusion', 'to sum up', 'in summary', 'ultimately',
        'all in all', 'to conclude', 'in the end'
    ];
    conclusions.forEach(phrase => {
        if (text.toLowerCase().includes(phrase)) {
            aiScore += 5;
            indicators.push({ phrase, reason: 'Generic AI conclusion' });
        }
    });
    
    // 10. Excessive use of "the fact that"
    const factCount = (text.match(/the fact that/gi) || []).length;
    if (factCount >= 2) {
        aiScore += 4;
        indicators.push({ phrase: 'Multiple "the fact that"', reason: 'AI verbal tic' });
    }
    
    // Cap at 100
    aiScore = Math.min(100, aiScore);
    
    return {
        score: aiScore,
        likelihood: aiScore >= 70 ? 'Very High' : aiScore >= 50 ? 'High' : aiScore >= 30 ? 'Medium' : 'Low',
        color: aiScore >= 70 ? '#F44336' : aiScore >= 50 ? '#FF9800' : aiScore >= 30 ? '#FFC107' : '#4CAF50',
        indicators: indicators.slice(0, 5), // Top 5 indicators
        isLikelyAI: aiScore >= 50
    };
}

// Generate AI-specific citation templates
function generateAICitations(detectedAsAI) {
    if (!detectedAsAI) return [];
    
    const currentYear = new Date().getFullYear();
    const currentDate = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    
    return [
        {
            format: 'APA 7 - ChatGPT',
            citation: `OpenAI. (${currentYear}). ChatGPT (Version GPT-4) [Large language model]. https://chat.openai.com`,
            inText: '(OpenAI, 2025)',
            usage: 'When to use: If the content appears to be from ChatGPT'
        },
        {
            format: 'APA 7 - Claude',
            citation: `Anthropic. (${currentYear}). Claude (Version 3) [Large language model]. https://claude.ai`,
            inText: '(Anthropic, 2025)',
            usage: 'When to use: If the content appears to be from Claude'
        },
        {
            format: 'APA 7 - Generic AI',
            citation: `AI Language Model. (${currentYear}). [AI-generated content]. Retrieved ${currentDate}`,
            inText: '(AI Language Model, 2025)',
            usage: 'When to use: If AI source is unknown'
        },
        {
            format: 'MLA 9 - ChatGPT',
            citation: `"Response to prompt." ChatGPT, version GPT-4, OpenAI, ${currentDate}, chat.openai.com.`,
            inText: '("Response")',
            usage: 'MLA format for ChatGPT'
        },
        {
            format: 'Chicago - AI Tool',
            citation: `OpenAI, "ChatGPT response to user query," ChatGPT, ${currentDate}, https://chat.openai.com.`,
            inText: '(OpenAI)',
            usage: 'Chicago style for AI citations'
        },
        {
            format: 'IEEE - AI Model',
            citation: `OpenAI, "ChatGPT GPT-4," ${currentYear}. [Online]. Available: https://chat.openai.com`,
            inText: '[1]',
            usage: 'IEEE format for technical papers'
        }
    ];
}

// Generate verification steps for AI content
function generateVerificationSteps(text, analysis) {
    const steps = [];
    
    steps.push({
        step: 1,
        action: 'Verify Factual Claims',
        description: 'Check all statistics, dates, and factual statements against primary sources',
        critical: true
    });
    
    if (analysis.statistics && analysis.statistics.length > 0) {
        steps.push({
            step: 2,
            action: 'Validate Statistics',
            description: `Found ${analysis.statistics.length} statistical claim(s). Verify each against original research or data sources`,
            critical: true
        });
    }
    
    if (analysis.entities.people.length > 0 || analysis.entities.companies.length > 0) {
        steps.push({
            step: 3,
            action: 'Verify Named Entities',
            description: `Check if ${analysis.entities.people.length} person(s) and ${analysis.entities.companies.length} organization(s) are real and correctly represented`,
            critical: true
        });
    }
    
    steps.push({
        step: 4,
        action: 'Find Primary Sources',
        description: 'Replace AI citations with original research papers, books, or authoritative sources',
        critical: true
    });
    
    steps.push({
        step: 5,
        action: 'Paraphrase & Credit',
        description: 'Rewrite AI-generated content in your own words and cite both the AI tool AND original sources',
        critical: false
    });
    
    if (analysis.weaselWords && analysis.weaselWords.length > 0) {
        steps.push({
            step: 6,
            action: 'Remove Vague Language',
            description: `Found ${analysis.weaselWords.length} weasel word(s). Replace with specific, verifiable statements`,
            critical: false
        });
    }
    
    steps.push({
        step: 7,
        action: 'Cross-Reference Multiple Sources',
        description: 'Confirm information appears in at least 2-3 independent, credible sources',
        critical: true
    });
    
    return steps;
}

// Detect weasel words (vague, unspecific language)
function detectWeaselWords(text) {
    const weaselPatterns = [
        { word: 'some people say', severity: 'high' },
        { word: 'it is believed', severity: 'high' },
        { word: 'many experts', severity: 'medium' },
        { word: 'widely considered', severity: 'medium' },
        { word: 'generally accepted', severity: 'medium' },
        { word: 'commonly believed', severity: 'medium' },
        { word: 'often said', severity: 'medium' },
        { word: 'most people', severity: 'medium' },
        { word: 'some say', severity: 'high' },
        { word: 'arguably', severity: 'low' },
        { word: 'possibly', severity: 'low' },
        { word: 'potentially', severity: 'low' },
        { word: 'may be', severity: 'low' },
        { word: 'might be', severity: 'low' },
        { word: 'could be', severity: 'low' },
        { word: 'it seems', severity: 'medium' },
        { word: 'appears to be', severity: 'medium' },
        { word: 'reportedly', severity: 'high' },
        { word: 'allegedly', severity: 'high' }
    ];
    
    const found = [];
    weaselPatterns.forEach(pattern => {
        const regex = new RegExp(`\\b${pattern.word}\\b`, 'gi');
        const matches = text.match(regex);
        if (matches) {
            found.push({
                phrase: matches[0],
                severity: pattern.severity,
                count: matches.length
            });
        }
    });
    
    return found;
}

// Extract statistical claims
function extractStatistics(text) {
    const stats = [];
    
    // Percentages
    const percentages = text.match(/\d+(\.\d+)?%/g);
    if (percentages) {
        percentages.forEach(p => {
            const context = extractContext(text, p, 50);
            stats.push({
                type: 'percentage',
                value: p,
                context: context,
                icon: '📊'
            });
        });
    }
    
    // Large numbers (with commas or in scientific notation)
    const numbers = text.match(/\d{1,3}(,\d{3})+(\.\d+)?|\d+(\.\d+)?\s*(million|billion|trillion|thousand)/gi);
    if (numbers) {
        numbers.forEach(n => {
            const context = extractContext(text, n, 50);
            stats.push({
                type: 'number',
                value: n,
                context: context,
                icon: '🔢'
            });
        });
    }
    
    // Years/Dates
    const years = text.match(/\b(19|20)\d{2}\b/g);
    if (years) {
        years.forEach(y => {
            const context = extractContext(text, y, 50);
            stats.push({
                type: 'year',
                value: y,
                context: context,
                icon: '📅'
            });
        });
    }
    
    // Ratios (1 in 5, 3 out of 4, etc.)
    const ratios = text.match(/\d+\s+(in|out of)\s+\d+/gi);
    if (ratios) {
        ratios.forEach(r => {
            const context = extractContext(text, r, 50);
            stats.push({
                type: 'ratio',
                value: r,
                context: context,
                icon: '⚖️'
            });
        });
    }
    
    return stats;
}

function extractContext(text, phrase, length) {
    const index = text.indexOf(phrase);
    if (index === -1) return phrase;
    
    const start = Math.max(0, index - length);
    const end = Math.min(text.length, index + phrase.length + length);
    
    let context = text.substring(start, end);
    if (start > 0) context = '...' + context;
    if (end < text.length) context = context + '...';
    
    return context;
}

// Extract URLs and potential sources
function extractSources(text) {
    const sources = [];
    
    // URLs
    const urlRegex = /(https?:\/\/[^\s]+)/g;
    const urls = text.match(urlRegex);
    if (urls) {
        urls.forEach(url => {
            sources.push({
                type: 'url',
                value: url,
                icon: '🔗'
            });
        });
    }
    
    // Journal/Publication patterns
    const journalPatterns = [
        /published in ([A-Z][a-zA-Z\s&]+)/g,
        /according to ([A-Z][a-zA-Z\s&]+)/g,
        /from ([A-Z][a-zA-Z\s&]+ (Journal|Review|Magazine|Times|Post))/g
    ];
    
    journalPatterns.forEach(pattern => {
        let match;
        while ((match = pattern.exec(text)) !== null) {
            sources.push({
                type: 'publication',
                value: match[1],
                icon: '📰'
            });
        }
    });
    
    return sources;
}

// Generate citation suggestions
function generateCitations(entities, sources) {
    const citations = [];
    
    // APA Style citations for entities
    entities.people.forEach(person => {
        const year = new Date().getFullYear();
        citations.push({
            style: 'APA',
            entity: person,
            citation: `${person} (${year}). [Title]. Retrieved from [URL]`,
            type: 'person'
        });
    });
    
    entities.organizations.forEach(org => {
        const year = new Date().getFullYear();
        citations.push({
            style: 'APA',
            entity: org,
            citation: `${org}. (${year}). [Title]. Retrieved from [URL]`,
            type: 'organization'
        });
    });
    
    // URL citations
    sources.filter(s => s.type === 'url').forEach(source => {
        citations.push({
            style: 'APA',
            entity: source.value,
            citation: `Author, A. A. (Year). Title of document. Retrieved from ${source.value}`,
            type: 'url'
        });
    });
    
    return citations;
}

// Find sentences containing keywords
function findReferenceSentences(text) {
    if (!keywords || keywords.length === 0) return [];

    const sentences = text.match(/[^.!?]+[.!?]*/g) || [];
    return sentences.filter(sentence => {
        const lower = sentence.toLowerCase();
        return keywords.some(k => lower.includes(k.toLowerCase()));
    });
}

// Analyze text for citation needs and accuracy issues
function analyzeText(text) {
    const findings = [];
    
    // Citation triggers
    const citationTriggers = [
        { pattern: /according to\s+(?:the\s+)?(?:study|research|report|survey|data|experts?|scientists?)/gi, phrase: 'according to', type: 'citation', tip: 'Provide a specific source name and date for this reference' },
        { pattern: /\bstudies show(?:s|ed|n)?\b/gi, phrase: 'studies show', type: 'citation', tip: 'Name the specific study or research organization' },
        { pattern: /\bresearch (?:indicates?|shows?|suggests?|demonstrates?|reveals?)\b/gi, phrase: 'research indicates', type: 'citation', tip: 'Cite the research paper or institution' },
        { pattern: /\bdata (?:shows?|suggests?|indicates?|reveals?)\b/gi, phrase: 'data shows', type: 'citation', tip: 'Link to the data source or dataset' },
        { pattern: /\bstatistics (?:show|indicate|suggest|reveal)\b/gi, phrase: 'statistics show', type: 'citation', tip: 'Provide the source of these statistics' },
        { pattern: /\breports? suggest(?:s|ed)?\b/gi, phrase: 'reports suggest', type: 'citation', tip: 'Cite the specific report and publisher' },
        { pattern: /\bevidence suggests?\b/gi, phrase: 'evidence suggests', type: 'citation', tip: 'Reference the source of this evidence' },
        { pattern: /\bexperts? (?:say|claim|believe|argue|suggest)\b/gi, phrase: 'experts say', type: 'citation', tip: 'Name the specific expert(s) and their credentials' },
        { pattern: /\d+(\.\d+)?%/g, phrase: 'percentage statistic', type: 'citation', tip: 'Cite the source and context of this percentage' }
    ];

    // Accuracy flags
    const accuracyFlags = [
        { pattern: /\b(?:everyone|everybody|no one|nobody|all people)\b/gi, phrase: 'absolute generalization', type: 'warning', tip: 'Avoid absolute generalizations. Use "most", "many", or "some" instead' },
        { pattern: /\balways\b/gi, phrase: 'absolute statement (always)', type: 'warning', tip: 'Replace "always" with "typically", "often", or "usually"' },
        { pattern: /\bnever\b/gi, phrase: 'absolute statement (never)', type: 'warning', tip: 'Replace "never" with "rarely" or "seldom"' },
        { pattern: /\b(?:definitely|certainly|absolutely|without (?:a )?doubt)\b/gi, phrase: 'absolute certainty', type: 'warning', tip: 'Soften absolute language. Consider "likely" or "very probable"' },
        { pattern: /\ball (?:scientists|experts|researchers) agree\b/gi, phrase: 'false consensus', type: 'warning', tip: 'Specify the percentage or use "most"' },
        { pattern: /\b100% (?:safe|effective|accurate|certain)\b/gi, phrase: 'absolute guarantee', type: 'warning', tip: 'Use "highly effective" or cite specific success rates' }
    ];

    // Check for accuracy flags (errors)
    accuracyFlags.forEach(flag => {
        const matches = text.match(flag.pattern);
        if (matches) {
            const uniqueMatches = [...new Set(matches)];
            uniqueMatches.forEach(match => {
                findings.push({
                    type: 'error',
                    trigger: match,
                    message: `"${match}" - ${flag.phrase}`,
                    suggestion: flag.tip
                });
            });
        }
    });

    // Check for citation triggers (warnings)
    citationTriggers.forEach(trigger => {
        const matches = text.match(trigger.pattern);
        if (matches) {
            const uniqueMatches = [...new Set(matches)];
            uniqueMatches.forEach(match => {
                findings.push({
                    type: 'warning',
                    trigger: match,
                    message: `"${match}" - This phrase indicates a source should be cited`,
                    suggestion: trigger.tip
                });
            });
        }
    });

    return {
        text: text,
        findings: findings,
        needsCitation: findings.filter(f => f.type === 'warning').length,
        needsReview: findings.filter(f => f.type === 'error').length
    };
}

